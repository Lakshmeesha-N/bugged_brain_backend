<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ name }} - Resume</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 20px;
      color: #333;
      line-height: 1.4;
    }
    h1 {
      margin-bottom: 4px;
      font-size: 24px;
      color: #111;
      text-transform: uppercase;
    }
    .contact {
      font-size: 13px;
      color: #555;
      margin-bottom: 16px;
    }
    .section-title {
      font-size: 15px;
      font-weight: bold;
      border-bottom: 1px solid #ccc;
      padding-bottom: 2px;
      margin-top: 14px;
      margin-bottom: 6px;
      text-transform: uppercase;
      color: #222;
    }
    .item {
      margin-bottom: 8px;
    }
    .item-header {
      font-weight: bold;
      font-size: 14px;
      display: flex;
      justify-content: space-between;
    }
    .item-sub {
      font-style: italic;
      font-size: 13px;
      color: #444;
    }
    ul {
      margin: 4px 0 6px 18px;
      padding: 0;
    }
    li {
      font-size: 13px;
      margin-bottom: 2px;
    }
  </style>
</head>
<body>
  <h1>{{ name }}</h1>
  <div class="contact">
    <span>{{ email }}</span>
    {% if phone %} | <span>{{ phone }}</span>{% endif %}
    {% if location %} | <span>{{ location }}</span>{% endif %}
    {% if links %}
      {% if links.linkedin %} | <a href="{{ links.linkedin }}">LinkedIn</a>{% endif %}
      {% if links.github %} | <a href="{{ links.github }}">GitHub</a>{% endif %}
      {% if links.portfolio %} | <a href="{{ links.portfolio }}">Portfolio</a>{% endif %}
    {% endif %}
  </div>

  {% if summary %}
  <div class="section-title">Summary</div>
  <p style="font-size: 13px; margin: 0;">{{ summary }}</p>
  {% endif %}

  <div class="section-title">Education</div>
  {% for edu in education %}
  <div class="item">
    <div class="item-header">{{ edu.institution }}{% if edu.year %} - {{ edu.year }}{% endif %}</div>
    <div class="item-sub">{{ edu.degree }}{% if edu.grade %} | {{ edu.grade }}{% endif %}</div>
  </div>
  {% endfor %}

  {% if skills %}
  <div class="section-title">Skills</div>
  <p style="font-size: 13px; margin: 0;">{{ skills | join(', ') }}</p>
  {% endif %}

  {% if experience %}
  <div class="section-title">Experience</div>
  {% for exp in experience %}
  <div class="item">
    <div class="item-header">{{ exp.role }} - {{ exp.company }}{% if exp.duration %} ({{ exp.duration }}){% endif %}</div>
    {% if exp.bullets %}
    <ul>
      {% for b in exp.bullets %}
      <li>{{ b }}</li>
      {% endfor %}
    </ul>
    {% elif exp.description %}
    <p style="font-size: 13px; margin: 2px 0;">{{ exp.description }}</p>
    {% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if projects %}
  <div class="section-title">Projects</div>
  {% for p in projects %}
  <div class="item">
    <div class="item-header">{{ p.title }}{% if p.link %} (<a href="{{ p.link }}">Link</a>){% endif %}</div>
    {% if p.tech_stack %}
    <div class="item-sub">Technologies: {{ p.tech_stack | join(', ') }}</div>
    {% endif %}
    {% if p.bullets %}
    <ul>
      {% for b in p.bullets %}
      <li>{{ b }}</li>
      {% endfor %}
    </ul>
    {% elif p.description %}
    <p style="font-size: 13px; margin: 2px 0;">{{ p.description }}</p>
    {% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if achievements %}
  <div class="section-title">Achievements</div>
  {% for ach in achievements %}
  <div class="item">
    <div class="item-header">{{ ach.title }}{% if ach.year %} ({{ ach.year }}){% endif %}</div>
    {% if ach.description %}<p style="font-size: 13px; margin: 2px 0;">{{ ach.description }}</p>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if certifications %}
  <div class="section-title">Certifications</div>
  {% for cert in certifications %}
  <div class="item">
    <div class="item-header">{{ cert.name }}{% if cert.issuer %} - {{ cert.issuer }}{% endif %}{% if cert.year %} ({{ cert.year }}){% endif %}</div>
  </div>
  {% endfor %}
  {% endif %}

  {% if extracurriculars %}
  <div class="section-title">Extracurriculars</div>
  {% for extra in extracurriculars %}
  <div class="item">
    <div class="item-header">{{ extra.title }}{% if extra.role %} - {{ extra.role }}{% endif %}</div>
    {% if extra.description %}<p style="font-size: 13px; margin: 2px 0;">{{ extra.description }}</p>{% endif %}
  </div>
  {% endfor %}
  {% endif %}
</body>
</html>
